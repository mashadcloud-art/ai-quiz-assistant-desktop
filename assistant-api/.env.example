# Copy this file to .env before running the server.

# Port the Express API listens on
PORT=3001

# Your Ollama server
OLLAMA_BASE_URL=http://129.159.235.164:11434

# Default model (phi3 for speed, llama3 for harder tasks)
OLLAMA_MODEL=phi3:latest

# How long to wait for a response before timing out (milliseconds)
OLLAMA_TIMEOUT_MS=60000

# ── Gemini (optional — free tier) ─────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
